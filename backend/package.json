{
  "name": "memory-match-backend",
  "version": "1.0.0",
  "description": "Express backend for Adaptive Memory Matching Game",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.18.3",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "^22.15.0",
    "@types/supertest": "6.0.2",
    "@types/uuid": "9.0.7",
    "supertest": "6.3.4",
    "ts-node-dev": "2.0.0",
    "typescript": "5.3.3",
    "vite": "5.4.18",
    "vitest": "3.1.4"
  },
  "overrides": {
    "rollup": "4.63.6"
  }
}
